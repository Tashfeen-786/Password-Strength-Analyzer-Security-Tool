# Password Strength Analyzer — example environment configuration.
# No secrets are required anywhere in this project.

# Maximum accepted password length (PDF: 128+)
PSA_MAX_PASSWORD_LENGTH=128

# Privacy-safe aggregate analytics (true/false). Even when true, only safe
# metadata is stored: score, classification, length, unique ratio,
# weakness count, timestamp. NEVER the password.
PSA_ENABLE_ANALYTICS=true

# SQLite database location
PSA_DB_PATH=backend/analytics.db

# Demo-grade in-memory rate limiting
PSA_RATE_LIMIT_REQUESTS=60
PSA_RATE_LIMIT_WINDOW_SECONDS=60
